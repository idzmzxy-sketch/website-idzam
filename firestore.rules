rules_version = '2';

// Tempel seluruh isi file ini di Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function uploadsAllowed() {
      return exists(/databases/$(database)/documents/config/site)
        && get(/databases/$(database)/documents/config/site).data.get('allowUserUploads', false) == true;
    }

    // Profil: bisa dilihat semua orang.
    match /users/{uid} {
      allow read: if true;

      // Akun pertama di dunia jadi admin: profil admin hanya boleh dibuat bersamaan dengan
      // dokumen config/admin (yang hanya bisa dibuat SEKALI). Selain itu hanya role "user".
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'role', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && (
          request.resource.data.role == 'user'
          || (
            request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/config/admin)
            && getAfter(/databases/$(database)/documents/config/admin).data.uid == uid
          )
        );

      // Role tidak boleh diubah dari browser.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'role', 'createdAt']);

      allow delete: if false;
    }

    // Penanda "admin sudah ada". Hanya bisa dibuat sekali, tidak bisa dibaca/diubah.
    match /config/admin {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Pengaturan situs: semua orang boleh baca, hanya admin yang boleh mengubah.
    match /config/site {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['defaultBackground', 'allowUserUploads']);
      allow delete: if false;
    }

    // Our story: semua orang boleh membaca, hanya member yang login boleh menulis.
    match /stories/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['kind', 'title', 'description', 'url', 'thumb', 'mediaId', 'fileName', 'fileSize',
              'ownerId', 'ownerName', 'ownerPhoto', 'createdAt'])
        && request.resource.data.kind in ['note', 'image', 'file', 'link']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && (request.resource.data.get('url', null) == null
            || (request.resource.data.url is string
                && request.resource.data.url.matches('https://.*')
                && request.resource.data.url.size() <= 1000))
        && (request.resource.data.get('thumb', null) == null
            || (request.resource.data.thumb is string
                && request.resource.data.thumb.matches('data:image/.*')
                && request.resource.data.thumb.size() <= 120000));
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Foto/file ukuran penuh untuk Our story (dibaca hanya saat diketuk).
    match /storyMedia/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'data', 'mime', 'name', 'size', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000;
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Chat global: hanya yang login yang boleh membaca dan menulis.
    match /chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['text', 'ownerId', 'ownerName', 'ownerPhoto', 'createdAt', 'attachment'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0
            || request.resource.data.get('attachment', null) != null)
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 100
        && (request.resource.data.get('attachment', null) == null
            || (request.resource.data.attachment is map
                && request.resource.data.attachment.get('mediaId', null) is string));
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Foto/file ukuran penuh untuk chat global.
    match /chatMedia/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'data', 'mime', 'name', 'size', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000;
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Background yang dibagikan lewat link.
    match /backgrounds/{id} {
      allow read: if true;

      // Tambah: admin, atau semua member kalau admin menyalakan "allowUserUploads".
      allow create: if signedIn()
        && (isAdmin() || uploadsAllowed())
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['title', 'description', 'url', 'mediaType', 'uploaderId', 'uploaderName', 'uploaderPhoto', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://.*')
        && request.resource.data.url.size() <= 1000
        && request.resource.data.mediaType in ['video', 'image'];

      // Hapus: hanya yang menambahkan, atau admin (bisa hapus semua).
      allow delete: if signedIn()
        && (resource.data.uploaderId == request.auth.uid || isAdmin());

      allow update: if false;
    }
  }
}
